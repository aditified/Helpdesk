# Database (PostgreSQL URL provided by Render or Supabase/Neon)
DATABASE_URL="postgresql://user:password@host:5432/helpdesk?sslmode=require"

# Auth Secrets
BETTER_AUTH_SECRET="your-32-character-secret-key-here"
BETTER_AUTH_URL="https://your-app.onrender.com"
TRUSTED_ORIGINS="https://your-app.onrender.com"
WEBHOOK_SECRET="your-webhook-secret-string"

# AI Integration (Gemini)
GOOGLE_GENERATIVE_AI_API_KEY="your-google-gemini-api-key"

# Email Notifications (SMTP / Gmail App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Helpdesk <your-email@gmail.com>"

# Inbound Email Listener (IMAP)
IMAP_HOST="imap.gmail.com"
IMAP_PORT="993"
IMAP_SECURE="true"
IMAP_USER="your-email@gmail.com"
IMAP_PASS="your-app-password"
IMAP_POLL_INTERVAL="60"

# Initial Admin Seeding
SEED_ADMIN_EMAIL="admin@helpdesk.com"
SEED_ADMIN_PASSWORD="YourSecurePassword123!"

# Instagram Direct Integration
INSTAGRAM_VERIFY_TOKEN="helpdesk_instagram_verify_token"
INSTAGRAM_PAGE_ACCESS_TOKEN="your-instagram-access-token"
INSTAGRAM_PAGE_ID="17841420417477217"
INSTAGRAM_APP_SECRET="your-meta-app-secret"
INSTAGRAM_APP_ID="1766980764411444"
